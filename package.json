{
  "name": "chart.js-image",
  "version": "6.1.387",
  "description": "Render Chart.JS as Image (or URL of Image)",
  "main": "lib.js",
  "types": "types.d.ts",
  "scripts": {
    "test": "jest --coverage ./test.js",
    "@comment updr": "-r basic : Uses console.log for output, no need for a TTY (e.g when running on CI) => https://www.npmjs.com/package/updtr#--reporter--r",
    "updtr": "updtr -r basic"
  },
  "engines":{
    "node": ">12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "6.1.387",
      "onFail": "warn"
    }
  },
  "jest": {
    "verbose": true,
    "cacheDirectory": ".jest_cache",
    "testEnvironment": "node",
    "testTimeout": 5000,
    "snapshotFormat": {
      "printBasicPrototype": true
    },
    "coverageDirectory": "coverage",
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "modulePaths": [
      "<rootDir>/src/"
    ],
    "reporters": [
      "default",
      ["jest-junit", {
        "outputDirectory": "coverage",
        "outputName": "junit.xml"
      }]
    ],
    "coverageThreshold": {
      "global": {
        "branches": 89,
        "functions": 95,
        "lines": 100,
        "statements": 98
      }
    }
  },
  "author": "Francois-Guillaume Ribreau <npm@fgribreau.com> (http://fgribreau.com/)",
  "license": "MIT",
  "dependencies": {
  "javascript-stringify": "^2.1.0",
  "node-fetch": "^2.6.0"
},
  "devDependencies": {
  "@babel/core": "^8.0.0",
  "@babel/preset-env": "^8.0.0",
  "babel-jest": "^30.4.1",
  "jest": "^30.0.0",
  "jest-junit": "^17.0.0",
  "npm-release": "^1.0.0",
  "updtr": "^4.1.0"
},
  "overrides": {
    "@babel/core": "$@babel/core"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/image-charts/.git"
  },
  "keywords": [
  "chartjs",
  "charts",
  "chart-url",
  "image",
  "imagecharts",
  "png",
  "jpg",
  "jpeg",
  "gif",
  "animated",
  "api",
  "pie",
  "bar",
  "horizontal-bar",
  "bubble",
  "doughnut",
  "line",
  "polar"
],
  "bugs": {
    "url": "https://github.com/image-charts//issues"
  },
  "homepage": "https://github.com/image-charts/#readme",
  "contributors": [ ]
}
